# Copy to .env and fill in. .env is gitignored.
QR_TOKEN=rings-200.xxxxxxxx
QR_ACCOUNT=you@example.com
GEMINI_API_KEY=your-gemini-key
# Optional: pin a Gemini model id; empty = auto-pick a Flash model from the API's model list
GEMINI_MODEL=
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Optional: Tiger Data (TimescaleDB) connection string, e.g. postgres://tsdbadmin:pw@host:port/tsdb?sslmode=require
TIGER_DATABASE_URL=
